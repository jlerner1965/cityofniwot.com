{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "https://insideniwot.com/",
      "permanent": true
    },
    {
      "source": "/eat-shop{/}?",
      "destination": "https://insideniwot.com/eat-drink/",
      "permanent": true
    },
    {
      "source": "/explore{/}?",
      "destination": "https://insideniwot.com/things-to-do/",
      "permanent": true
    },
    {
      "source": "/plan-a-visit{/}?",
      "destination": "https://insideniwot.com/articles/explore-niwot-in-walking-order/",
      "permanent": true
    },
    {
      "source": "/our-story{/}?",
      "destination": "https://insideniwot.com/articles/how-niwot-got-here/",
      "permanent": true
    },
    {
      "source": "/community{/}?",
      "destination": "https://insideniwot.com/articles/who-runs-what-in-niwot/",
      "permanent": true
    },
    {
      "source": "/civic/incorporation-election{/}?",
      "destination": "https://insideniwot.com/articles/2026-incorporation-election/",
      "permanent": true
    },
    {
      "source": "/civic{/}?",
      "destination": "https://insideniwot.com/articles/2026-incorporation-election/",
      "permanent": true
    },
    {
      "source": "/events{/}?",
      "destination": "https://insideniwot.com/events/",
      "permanent": true
    },
    {
      "source": "/contact{/}?",
      "destination": "https://insideniwot.com/contact/",
      "permanent": true
    },
    {
      "source": "/thanks{/}?",
      "destination": "https://insideniwot.com/contact/",
      "permanent": true
    },
    {
      "source": "/privacy{/}?",
      "destination": "https://insideniwot.com/privacy/",
      "permanent": true
    },
    {
      "source": "/events/basin-design-open-house-2026-09-19{/}?",
      "destination": "https://insideniwot.com/events/basin-design-open-house-2026-09-19/",
      "permanent": true
    },
    {
      "source": "/events/enchanted-evening-2026{/}?",
      "destination": "https://insideniwot.com/events/enchanted-evening-2026/",
      "permanent": true
    },
    {
      "source": "/events/first-friday-art-walk-2026-12-04{/}?",
      "destination": "https://insideniwot.com/events/first-friday-art-walk-2026-12-04/",
      "permanent": true
    },
    {
      "source": "/events/holiday-parade-2026{/}?",
      "destination": "https://insideniwot.com/events/holiday-parade-2026/",
      "permanent": true
    },
    {
      "source": "/events/lets-wine-about-winter-2027{/}?",
      "destination": "https://insideniwot.com/events/lets-wine-about-winter-2027/",
      "permanent": true
    },
    {
      "source": "/events/:slug*{/}?",
      "destination": "https://insideniwot.com/events/",
      "permanent": true
    },
    {
      "source": "/:path*{/}?",
      "destination": "https://insideniwot.com/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "townofniwot.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
